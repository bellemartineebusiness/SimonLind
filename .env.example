# Web3Forms API key — server-side only, never exposed to the client bundle.
# Get your free key at https://web3forms.com and register your email address.
# Set this as a secret in Vercel: Settings → Environment Variables → WEB3FORMS_KEY
WEB3FORMS_KEY=your_web3forms_key_here

# Alternative for local development only (exposed to browser — prefer WEB3FORMS_KEY above).
# Uncomment and set if you cannot use the server-side variable during dev.
# NEXT_PUBLIC_WEB3FORMS_KEY=your_web3forms_key_here

# Temporary test email for isolating delivery issues (e.g. iCloud vs Gmail).
# When set, the proxy includes `test_recipient` in the Web3Forms payload.
# Note: Web3Forms may not honour recipient overrides depending on account settings.
# SUPPORT_TEST_EMAIL=your-test@gmail.com
