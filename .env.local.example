# Web3Forms API key — get yours free at https://web3forms.com
#
# SERVER-SIDE SECRET (recommended – set as Vercel secret in production):
WEB3FORMS_KEY=your_web3forms_key_here
#
# CLIENT-SIDE FALLBACK (backwards-compatible, used if WEB3FORMS_KEY is not set):
NEXT_PUBLIC_WEB3FORMS_KEY=your_web3forms_key_here
#
# Optional: set a test email address to receive test submissions via the proxy.
# When set, submissions are routed to this address instead of the default recipient.
SUPPORT_TEST_EMAIL=
